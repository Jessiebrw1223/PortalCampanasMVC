@model List<PortalCampanasMVC.Models.Campana>
@{
    ViewData["Title"] = "Campañas Comerciales";
    var categorias = ViewBag.Categorias as List<string>;
    var estados = ViewBag.Estados as List<string>;
}

<h1 class="mb-4">Campañas Comerciales</h1>

<form method="get" class="row g-3 mb-4 align-items-end">
    <div class="col-md-3">
        <label class="form-label">Categoría</label>
        <select name="categoria" class="form-select">
            <option value="">Todas</option>
            @foreach (var categoria in categorias!)
            {
                <option value="@categoria" selected="@(ViewBag.CategoriaSeleccionada == categoria)">@categoria</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Estado</label>
        <select name="estado" class="form-select">
            <option value="">Todos</option>
            @foreach (var estado in estados!)
            {
                <option value="@estado" selected="@(ViewBag.EstadoSeleccionado == estado)">@estado</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-retail">Filtrar</button>
        <a asp-controller="Campanas" asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<div class="row">
    @foreach (var item in Model)
    {
        var badgeClass = item.Estado == "Vigente" ? "badge-vigente" : item.Estado == "Próxima" ? "badge-proxima" : "badge-finalizada";
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card campaign-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                        <h4 class="card-title mb-0">@item.Nombre</h4>
                        <span class="campaign-badge @badgeClass">@item.Estado</span>
                    </div>
                    <p class="text-muted mb-1"><strong>@item.Categoria</strong> · @item.DescuentoPct % · @item.FechaFin.ToString("dd MMM. yyyy")</p>
                    <p class="mb-1"><span class="channel-chip">@item.Canal</span></p>
                    <p class="text-muted small mb-4">@item.FechaInicio.ToString("dd MMM. yyyy") - @item.FechaFin.ToString("dd MMM. yyyy")</p>
                    <a asp-controller="Campanas" asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-light border mt-auto">Ver detalle</a>
                </div>
            </div>
        </div>
    }
</div>

<p class="text-muted">@Model.Count campaña(s) encontrada(s)</p>
