<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RetailCam</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="border-bottom bg-white shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light container py-3">
            <a class="navbar-brand fw-bold text-danger" asp-controller="Campanas" asp-action="Index">RetailCam Portal</a>
            <div class="collapse navbar-collapse show">
                <ul class="navbar-nav ms-auto gap-lg-2">
                    <li class="nav-item"><a class="nav-link" asp-controller="Campanas" asp-action="Index">Listado</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Campanas" asp-action="Index">Filtrar</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Campanas" asp-action="Resumen">Resumen</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top text-muted py-3 mt-4 bg-white">
        <div class="container">
            &copy; 2026 - Sistema comercial retail
        </div>
    </footer>
</body>
</html>
